# ─── Shared ───────────────────────────────────────────────────────────────────
POSTGRES_PASSWORD=tabletap_secret

# ─── Backend (/backend/.env) ─────────────────────────────────────────────────
NODE_ENV=development
PORT=4000
DATABASE_URL=postgresql://tabletap_user:tabletap_secret@localhost:5432/tabletap
REDIS_URL=redis://localhost:6379

JWT_SECRET=replace_with_strong_secret_min_32_chars
JWT_REFRESH_SECRET=replace_with_another_strong_secret
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Cloudinary (Image storage)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Stripe (Payments)
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# CORS origins
FRONTEND_URL=http://localhost:3000
ADMIN_URL=http://localhost:3001
KITCHEN_URL=http://localhost:3002

# ─── Frontend / Admin / Kitchen (/frontend/.env.local etc.) ──────────────────
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_STRIPE_PK=pk_test_...
NEXT_PUBLIC_APP_URL=http://localhost:3000
